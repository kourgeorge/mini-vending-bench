# ──────────────────────────────────────────────
# Mini Vending Bench — environment variables
# These mirror the fields in config.json.
# config.json takes precedence; env vars are a
# convenience alternative for CI / scripting.
# ──────────────────────────────────────────────

# Agent model API key (OpenAI, Anthropic, etc.)
OPENAI_API_KEY=sk-your-agent-api-key-here

# Optional: custom base URL for OpenAI-compatible APIs
# Use this to point the agent at LiteLLM, Ollama, Azure, etc.
# OPENAI_BASE_URL=http://localhost:4000

# Supplier model API key (used for simulated email responses)
SUPPLIER_API_KEY=sk-your-supplier-api-key-here

# Optional: port for the UI API server (default: 3001)
# PORT=3001
